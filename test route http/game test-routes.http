### Variables
@baseUrl = http://localhost:8080
@contentType = application/json

### Variables de test (à adapter)
@hostUsername = lunaa
@hostPassword = securePassword124
@otherUsername = mtpc
@otherPassword = mtpc2005

# ============================================
# 1) LOGIN TOKENS
# ============================================

### 1.1 Login Host
# @name loginHost
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "username": "{{hostUsername}}",
  "password": "{{hostPassword}}"
}

### 1.2 Login Other User
# @name loginOther
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "username": "{{otherUsername}}",
  "password": "{{otherPassword}}"
}

# ============================================
# 2) GAME CONFIG
# ============================================

### 2.1 Success - valid config (host token required)
POST {{baseUrl}}/api/game/config
Content-Type: {{contentType}}
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxOSIsInVzZXJuYW1lIjoibHVuYWEiLCJpYXQiOjE3NzE4NjE2NzYsImV4cCI6MTc3MTk0ODA3Nn0.rYiB5Q2ki6OKPwOaUVj15DPQNK0JQCL8lnwDN9HKZMY

{
  "mode": "Q5",
  "categories": [1, 2, 9],
  "difficulties": ["EASY", "MEDIUM"]
}

### 2.2 Error - unauthorized (missing token)
POST {{baseUrl}}/api/game/config
Content-Type: {{contentType}}

{
  "mode": "Q5",
  "categories": [1, 2],
  "difficulties": ["EASY"]
}

### 2.3 Error - invalid mode
POST {{baseUrl}}/api/game/config
Content-Type: {{contentType}}
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxOSIsInVzZXJuYW1lIjoibHVuYWEiLCJpYXQiOjE3NzE4NjE2NzYsImV4cCI6MTc3MTk0ODA3Nn0.rYiB5Q2ki6OKPwOaUVj15DPQNK0JQCL8lnwDN9HKZMY

{
  "mode": "Q15",
  "categories": [1, 2],
  "difficulties": ["EASY"]
}

### 2.4 Error - empty categories
POST {{baseUrl}}/api/game/config
Content-Type: {{contentType}}
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxOSIsInVzZXJuYW1lIjoibHVuYWEiLCJpYXQiOjE3NzE4NjE2NzYsImV4cCI6MTc3MTk0ODA3Nn0.rYiB5Q2ki6OKPwOaUVj15DPQNK0JQCL8lnwDN9HKZMY

{
  "mode": "Q10",
  "categories": [],
  "difficulties": ["EASY", "MEDIUM"]
}

### 2.5 Error - invalid category id
POST {{baseUrl}}/api/game/config
Content-Type: {{contentType}}
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxOSIsInVzZXJuYW1lIjoibHVuYWEiLCJpYXQiOjE3NzE4NjE2NzYsImV4cCI6MTc3MTk0ODA3Nn0.rYiB5Q2ki6OKPwOaUVj15DPQNK0JQCL8lnwDN9HKZMY

{
  "mode": "Q10",
  "categories": [1, 999999],
  "difficulties": ["EASY", "MEDIUM"]
}

### 2.6 Error - invalid difficulties
POST {{baseUrl}}/api/game/config
Content-Type: {{contentType}}
Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxOSIsInVzZXJuYW1lIjoibHVuYWEiLCJpYXQiOjE3NzE4NjE2NzYsImV4cCI6MTc3MTk0ODA3Nn0.rYiB5Q2ki6OKPwOaUVj15DPQNK0JQCL8lnwDN9HKZMY

